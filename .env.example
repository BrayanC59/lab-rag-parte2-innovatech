# ==============================================================================
# Configuracion local del laboratorio RAG - Parte 2
# Copia este archivo como .env  ->  Copy-Item .env.example .env
# ==============================================================================

# --- Open WebUI ---------------------------------------------------------------
OPENWEBUI_BASE_URL=http://localhost:3000/api

# API Key creada en Open WebUI: Settings -> Account -> API Keys (formato sk-...)
# El script scripts/bootstrap_openwebui.py la genera automaticamente y la escribe aqui.
OPENWEBUI_API_KEY=sk-tu-api-key-aqui

# ID exacto del modelo personalizado (Workspace -> Models)
TARGET_MODEL=modelo-innovatech-2027

# Modelo juez opcional para evaluate_rag.py (vacio = no evaluar con juez)
JUDGE_MODEL=

# --- Cuenta administrador local ----------------------------------------------
# Open WebUI crea el primer usuario como administrador.
ADMIN_NAME=Administrador Innovatech
ADMIN_EMAIL=admin@innovatech.local
ADMIN_PASSWORD=Innovatech2027*

# --- Docker Compose -----------------------------------------------------------
# Clave con la que Open WebUI firma las sesiones. Cambiala en produccion.
WEBUI_SECRET_KEY=innovatech-lab-2027-cambia-esta-clave

# Nivel de logs del contenedor Open WebUI (DEBUG solo para diagnostico).
GLOBAL_LOG_LEVEL=INFO
